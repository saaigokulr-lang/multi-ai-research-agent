# OpenRouter API key used to authenticate LLM completion requests.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Tavily API key, used by later milestones for web search tool calls.
TAVILY_API_KEY=tvly-your-key-here

# Connection string for the primary relational database.
# If using Supabase AND running via Docker: use the Session Pooler connection
# string (Project Settings -> Database -> Connection Pooling), not the direct
# "db.<project>.supabase.co" host. The direct host resolves to IPv6, which
# Docker's default network can't route out over -- it fails with "Network is
# unreachable" from inside a container even though it works fine outside one.
DATABASE_URL=postgresql://user:password@localhost:5432/research_assistant

# Connection string for the Redis instance (caching / task queues in later milestones).
REDIS_URL=redis://localhost:6379/0

# OpenRouter model identifier used when no model is explicitly requested.
DEFAULT_MODEL=openai/gpt-4o-mini

# Standard library logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Optional Groq API key. If set, LLMClient automatically retries against
# Groq when OpenRouter returns a rate-limit error. Leave unset to disable
# fallback entirely -- the app runs fine without it.
GROQ_API_KEY=
